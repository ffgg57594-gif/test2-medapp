<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_muted">

    <!-- Main content, centered -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <!-- Simple circular badge as a lightweight logo mark -->
        <View
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/logo_badge"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_tagline"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="36dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBrowseModels"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/browse_models"
            app:icon="@drawable/ic_models"
            app:iconGravity="textStart"
            app:cornerRadius="14dp" />

    </LinearLayout>

    <!-- Elegant footer credit, anchored to the bottom regardless of screen size -->
    <include
        layout="@layout/footer_credit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />

</RelativeLayout>
